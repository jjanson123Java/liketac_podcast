    "db:migrate:content": "drizzle-kit migrate --config=drizzle.content.config.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:seed-content": "tsx scripts/seed-content.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "2.4.0",
    "drizzle-orm": "^0.45.4",
