    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "latest"
  }
